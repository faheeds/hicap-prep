# Copy to .env and fill in real values.
# .env is gitignored; never commit real keys.

# --- Supabase (Epic 1) -------------------------------------------------------
# Grab both from the Supabase dashboard: Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Only used by server-side scripts/edge functions; keep this out of any
# browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (Epic 3) ---------------------------------------------------------
# 1. Create a Stripe account at https://stripe.com
# 2. Enable Test mode (toggle in the Stripe dashboard top-left)
# 3. Get your test-mode keys from Developers → API keys
# 4. Create three products + prices in the Stripe dashboard:
#      Individual Pass — one-time, $49 USD
#      Family Pass     — one-time, $79 USD
#      Annual Pass     — recurring, $129 USD/year
# 5. Copy each price's "price_..." ID below
# 6. Create a webhook endpoint at <SUPABASE_URL>/functions/v1/stripe-webhook
#    listening for: checkout.session.completed,
#                   customer.subscription.updated,
#                   customer.subscription.deleted
#    Copy the "whsec_..." signing secret below
# 7. Set all of these as Supabase project secrets:
#    supabase secrets set STRIPE_SECRET_KEY=sk_test_... STRIPE_WEBHOOK_SECRET=whsec_... \
#      STRIPE_PRICE_INDIVIDUAL=price_... STRIPE_PRICE_FAMILY=price_... STRIPE_PRICE_ANNUAL=price_...

STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_INDIVIDUAL=price_individual_49_usd
STRIPE_PRICE_FAMILY=price_family_79_usd
STRIPE_PRICE_ANNUAL=price_annual_129_usd

# --- Email (Epic 4, E4-4) ----------------------------------------------------
# Create a free Resend account at https://resend.com, verify a sender domain,
# then get an API key from the dashboard.
# Set both as Supabase project secrets:
#   supabase secrets set RESEND_API_KEY=re_... FROM_EMAIL=noreply@yourdomain.com
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# A random string used to authenticate the weekly-digest cron job call.
# Set as a Supabase project secret: supabase secrets set CRON_SECRET=your-random-value
# Use the same value in the cron job header (see migration 20260914000700).
CRON_SECRET=your-random-cron-secret
